# Macro to copy .vscode folder and update launch.json
macro(copy_vscode_settings target)
    message("Copying VS Code settings for target: ${target}")
    if(${target} MATCHES "app_mcu_h5" OR ${target} MATCHES "app_mcu_h7" OR ${target} MATCHES "nucleo_h563zi" OR ${target} MATCHES "nucleo_h7s3l8")
        if(${target} MATCHES "nucleo_h7s3l8")
            set(VSCODE_SRC "${BOARD_SUPPORT_DIR}/stm/.vscode_extmem")
        else()
            set(VSCODE_SRC "${BOARD_SUPPORT_DIR}/stm/.vscode")
        endif()
        set(VSCODE_DST "${CMAKE_CURRENT_SOURCE_DIR}/")
        set(SETTINGS_DST "${CMAKE_CURRENT_SOURCE_DIR}/.vscode")
        # Remove existing settings.json file if it exists
            set(SETTINGS_JSON "${CMAKE_CURRENT_SOURCE_DIR}/.vscode/settings.json")
            if(EXISTS "${SETTINGS_JSON}")
                file(REMOVE "${SETTINGS_JSON}")
        endif()
        if(EXISTS "${VSCODE_SRC}")
            file(GLOB VSCODE_FILES "${VSCODE_SRC}/*")
            file(COPY ${VSCODE_FILES} DESTINATION "${CMAKE_CURRENT_SOURCE_DIR}/.vscode")
        endif()
        if(${target} MATCHES "app_mcu_h5")
            set(SETTINGS_SRC "${BOARD_SUPPORT_DIR}/stm/app_mcu_h5/settings.json")
        elseif(${target} MATCHES "app_mcu_h7")
            set(SETTINGS_SRC "${BOARD_SUPPORT_DIR}/stm/app_mcu_h7/settings.json")
        elseif(${target} MATCHES "nucleo_h563zi")
            set(SETTINGS_SRC "${BOARD_SUPPORT_DIR}/stm/nucleo_h563zi_master/settings.json")
        elseif(${target} MATCHES "nucleo_h7s3l8")
            set(SETTINGS_SRC "${BOARD_SUPPORT_DIR}/stm/nucleo_h7s3l8/settings.json")
        endif()
        if(EXISTS "${SETTINGS_SRC}")
            file(COPY "${SETTINGS_SRC}" DESTINATION "${CMAKE_CURRENT_SOURCE_DIR}/.vscode")
        endif()
    endif()
endmacro()
